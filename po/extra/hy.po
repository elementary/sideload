#: data/sideload.metainfo.xml.in:9 data/sideload.desktop.in:2
msgid "Sideload"
msgstr "Sideload"

#: data/sideload.metainfo.xml.in:10 data/sideload.desktop.in:3
msgid "Install apps downloaded from the Internet"
msgstr "Տեղադրել համացանցից ներբեռնված հավելվածներ"

#: data/sideload.metainfo.xml.in:12
msgid ""
"Sideload Flatpak apps per user and automatically add their remotes to "
"AppCenter. Sideload shows important information about apps before you "
"install like their download size."
msgstr ""
"Տեղադրեք Flatpak հավելվածներ յուրաքանչյուր օգտատիրոջ համար և ավտոմատ "
"ավելացրեք դրանց հեռակա պահոցները AppCenter-ում։ Sideload-ը տեղադրումից առաջ "
"ցույց է տալիս հավելվածների մասին կարևոր տեղեկություններ, օրինակ՝ ներբեռնման "
"չափը։"

#: data/sideload.metainfo.xml.in:53
msgid "elementary, Inc."
msgstr "elementary, Inc."

#: data/sideload.metainfo.xml.in:62 data/sideload.metainfo.xml.in:70
#: data/sideload.metainfo.xml.in:81 data/sideload.metainfo.xml.in:89
#: data/sideload.metainfo.xml.in:102 data/sideload.metainfo.xml.in:116
#: data/sideload.metainfo.xml.in:128
msgid "Updated translations"
msgstr "Թարմացված թարգմանություններ"

#: data/sideload.metainfo.xml.in:101
msgid "Show whether or not apps ask for advanced system permissions"
msgstr ""
"Ցուցադրվում է՝ արդյոք հավելվածները պահանջում են համակարգի առաջադեմ "
"թույլտվություններ"

#: data/sideload.metainfo.xml.in:114
msgid "Use updated Flatpak branding"
msgstr "Օգտագործվում է Flatpak-ի թարմացված բրենդինգը"

#: data/sideload.metainfo.xml.in:115
msgid "Badge notifications with the sideloaded app's icon"
msgstr "Ծանուցումները նշվում են տեղադրված հավելվածի պատկերակով"

#: data/sideload.metainfo.xml.in:127
msgid "Fix blurry app icon in multitasking view"
msgstr "Շտկվել է հավելվածի պղտոր պատկերակը բազմախնդիր դիտման մեջ"

#: data/sideload.desktop.in:4
msgid "Flatpak Installer"
msgstr "Flatpak-ի տեղադրիչ"

#: data/sideload.desktop.in:7
msgid "flatpak;"
msgstr "flatpak;"
